{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":false},"erDesign":{"model":{"uid":59,"erCode":"/* Entities */\nentity TRIBUNALE {\n    Indirizzo,\n    Citta,\n    Telefono (multi),\n    ID_T (id)\n}\nentity AULA {\n    ID_Aula (external),\n    Nome\n}\nentity GIORNO {\n    Giorno (id)\n}\nentity PERSONE {\n    Nome,\n    ID_persona (id),\n    Cellulare\n}\nentity GIUDICI\nentity AVVOCATO {\n    Indirizzo\n}\nentity TITOLO {\n    Titolo (id)\n}\nentity CAUSA {\n    Data_Inizio,\n    Nome,\n    Data_Fine (optional),\n    ID_Causa (id)\n}\nentity UDIENZA {\n    OraInizio (external),\n    Data (external),\n    OraFine (optional)\n}\n\n/* Relationships */\nrelationship APRIRE (\n    GIORNO: zero..many,\n    TRIBUNALE: zero..many\n) {\n    Chiusura,\n    apertura\n}\nrelationship APPARTENERE (\n    TRIBUNALE: one..many,\n    AULA: one..one external\n)\nrelationship ACQUISITO (\n    TITOLO: zero..many,\n    GIUDICI: one..many\n) {\n    Motivazione,\n    Data\n}\nrelationship SEGUIRE (\n    CAUSA: one..one,\n    AVVOCATO: zero..many\n)\nrelationship TENERE (\n    UDIENZA: one..one,\n    CAUSA: one..many\n)\nrelationship ORA (\n    UDIENZA: one..one external,\n    AULA: zero..many\n)\n\n/* Generalizations */\nPERSONE <= {\n    AVVOCATO,\n    GIUDICI\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"TRIBUNALE","_x":1,"_y":-179,"_mag":false},{"__type":"Attribute","_id":2,"_name":"Indirizzo","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-157,"_y":0},{"__type":"Attribute","_id":3,"_name":"Citta","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-155,"_y":-47},{"__type":"Attribute","_id":4,"_name":"Telefono","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_N","_parentId":1,"_x":-155,"_y":47},{"__type":"Attribute","_id