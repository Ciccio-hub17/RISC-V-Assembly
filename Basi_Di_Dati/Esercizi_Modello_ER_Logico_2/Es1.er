tionships */\nrelationship FORNIRE (\n    FORNITORE: one..many,\n    SPECIE: zero..one\n)\nrelationship ASSUMERE (\n    SPECIE: one..many,\n    TEMPO: one..many\n) {\n    fine (optional),\n    prezzo\n}\nrelationship ACQUISTARE (\n    CLIENTE: zero..many,\n    SPECIE: zero..many,\n    DATA: zero..many\n) {\n    quantita\n}\nrelationship ASSUME (\n    COLORE: one..many,\n    SPECIE: zero..one\n)\n\n/* Generalizations */\nCLIENTE <= {\n    PRIVATO,\n    RIVENDITE\n} (total, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE FORNITORE (\n    COD_F INTEGER NOT NULL,\n    Nome INTEGER NOT NULL,\n    CF INTEGER NOT NULL,\n    Indirizzo INTEGER NOT NULL,\n    PRIMARY KEY (COD_F)\n);\nCREATE TABLE CLIENTE (\n    ID INTEGER NOT NULL,\n    Attribute7 INTEGER NOT NULL,\n    Attribute9 INTEGER NOT NULL,\n    CF INTEGER,\n    P_IVA INTEGER,\n    Type INTEGER NOT NULL,\n    PRIMARY KEY (ID)\n);\nCREATE TABLE TEMPO (\n    Inizio INTEGER NOT NULL,\n    PRIMARY KEY (Inizio)\n);\nCREATE TABLE COLORE (\n    colore INTEGER NOT NULL,\n    PRIMARY KEY (colore)\n);\nCREATE TABLE DATA (\n    data INTEGER NOT NULL,\n    ora INTEGER NOT NULL,\n    PRIMARY KEY (data, ora)\n);\nCREATE TABLE SPECIE (\n    ID_S INTEGER NOT NULL,\n    nome_comune INTEGER NOT NULL,\n    nome_latino INTEGER NOT NULL,\n    Esotico INTEGER NOT NULL,\n    GiardinoApp INTEGER NOT NULL,\n    tipo INTEGER NOT NULL,\n    FORNITORE_COD_F INTEGER,\n    COLORE_colore INTEGER,\n    PRIMARY KEY (ID_S),\n    FOREIGN KEY (FORNITORE_COD_F) REFERENCES FORNITORE (COD_F)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (COLORE_colore) REFERENCES COLORE (colore)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ASSUMERE (\n    SPECIE_ID_S INTEGER NOT NULL,\n    TEMPO_Inizio INTEGER NOT NULL,\n    fine INTEGER,\n    prezzo INTEGER NOT NULL,\n    PRIMARY KEY (SPECIE_ID_S, TEMPO_Inizio),\n    FOREIGN KEY (SPECIE_ID_S) REFERENCES SPECIE (ID_S)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (TEMPO_Inizio) REFERENCES TEMPO (Inizio)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ACQUISTARE (\n    SPECIE_ID_S INTEGER NOT NULL,\n    CLIENTE_ID INTEGER NOT NULL,\n    DATA_data INTEGER NOT NULL,\n    DATA_ora INTEGER NOT NULL,\n    quantita INTEGER NOT NULL,\n    PRIMARY KEY (SPECIE_ID_S, CLIENTE_ID, DATA_data, DATA_ora),\n    FOREIGN KEY (SPECIE_ID_S) REFERENCES SPECIE (ID_S)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (CLIENTE_ID) REFERENCES CLIENTE (ID)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (DATA_data, DATA_ora) REFERENCES DATA (data, ora)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);","itemsArray":[{"__type":"Table","_id":79,"_name":"SPECIE","_x":-172,"_y":-590,"_mag":false},{"__type":"Column","_id":84,"_name":"ID_S","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":0},{"__type":"Column","_id":85,"_name":"nome_comune","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":1},{"__type":"Column","_id":86,"_name":"nome_latino","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":2},{"__type":"Column","_id":87,"_name":"Esotico","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":3},{"__type":"Column","_id":88,"_name":"GiardinoApp","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":4},{"__type":"Column","_id":89,"_name":"tipo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":79,"_tableIndex":5},{"__type":"Table","_id":90,"_name":"FORNITORE","_x":513,"_y":-395,"_mag":false},{"__type":"Column","_id":92,"_name":"COD_F","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":90,"_tableIndex":0},{"__type":"Column","_id":93,"_name":"Nome","_type":"integer","_identifier":false,"_uniq