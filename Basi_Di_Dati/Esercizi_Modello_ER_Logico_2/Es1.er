8":{"__type":"Column","_id":128,"_name":"DATA_ora","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":121,"_tableIndex":3},"129":{"__type":"ForeignKey","_id":129,"_referencingColumnId":128,"_referencedColumnId":113},"130":{"__type":"Column","_id":130,"_name":"quantita","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":121,"_tableIndex":4},"131":{"__type":"Column","_id":131,"_name":"FORNITORE_COD_F","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":79,"_tableIndex":6},"132":{"__type":"ForeignKey","_id":132,"_referencingColumnId":131,"_referencedColumnId":92},"133":{"__type":"Column","_id":133,"_name":"COLORE_colore","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":79,"_tableIndex":7},"134":{"__type":"ForeignKey","_id":134,"_referencingColumnId":133,"_referencedColumnId":109}},"sqlLinearCode":"<h3>Relational logical schema</h3>FORNITORE (<u  style=\"text-decoration: underline;\">COD_F</u>, Nome, CF, Indirizzo)<br><br>\nCLIENTE (<u  style=\"text-decoration: underline;\">ID</u>, Attribute7, Attribute9, CF*, P_IVA*, Type)<br><br>\nTEMPO (<u  style=\"text-decoration: underline;\">Inizio</u>)<br><br>\nCOLORE (<u  style=\"text-decoration: underline;\">colore</u>)<br><br>\nDATA (<u  style=\"text-decoration: underline;\">data</u>, <u  style=\"text-decoration: underline;\">ora</u>)<br><br>\nSPECIE (<u  style=\"text-decoration: underline;\">ID_S</u>, nome_comune, nome_latino, Esotico, GiardinoApp, tipo, FORNITORE_COD_F*, COLORE_colore*)<br><br>\nASSUMERE (<u  style=\"text-decoration: underline;\">SPECIE_ID_S</u>, <u  style=\"text-decoration: underline;\">TEMPO_Inizio</u>, fine*, prezzo)<br><br>\nACQUISTARE (<u  style=\"text-decoration: underline;\">SPECIE_ID_S</u>, <u  style=\"text-decoration: underline;\">CLIENTE_ID</u>, <u  style=\"text-decoration: underline;\">DATA_data</u>, <u  style=\"text-decoration: underline;\">DATA_ora</u>, quantita)<br><br>\n\n<br><h3>Referential integrity constraints</h3>\n\n\n\n\nSPECIE (FORNITORE_COD_F)  REFERENCES FORNITORE  (COD_F)<br><br>SPECIE (COLORE_colore)  REFERENCES COLORE  (colore)<br><br>\nASSUMERE (SPECIE_ID_S)  REFERENCES SPECIE  (ID_S)<br><br>ASSUMERE (TEMPO_Inizio)  REFERENCES TEMPO  (Inizio)<br><br>\nACQUISTARE (SPECIE_ID_S)  REFERENCES SPECIE  (ID_S)<br><br>ACQUISTARE (CLIENTE_ID)  REFERENCES CLIENTE  (ID)<br><br>ACQUISTARE (DATA_data, DATA_ora)  REFERENCES DATA  (data, ora)<br><br>"},"edited":true,"sceneResetToken":1773664314287,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":"<p>Colore (<u>Colore)</u></p><p>Tempo <u>(Inizio)</u></p><p>Assumere (<u>Inizio</u>, <u>ID_S</u>, prezzo fine*)</p><p>Specie (<u>ID_S</u>, nome_latino, nome_comune, Esotico, tipo, GiardinoApp, ID_F*, colore*)</p><p>Colore (<u>colore</u>)</p><p>Cliente (<u>ID_C</u>, nome, indirizzo, IVA*, CF*)</p><p>Acquistare (<u>ID_S</u>, <u>ID_C</u>, <u>data</u>, quantita)</p><p>Data (<u>data</u>, <u>ora</u>)</p><p>Fornitore (<u>ID_F</u>, Indirizzo, Nome, CF)</p><p><br></p><p><br></p>","showNotesDataMenu":false}