d":68,"_tableId":null,"_relationshipId":81,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},"84":{"__type":"Entity","_id":84,"_name":"SESSIONE","_x":-82,"_y":-775,"_mag":false},"85":{"__type":"Relationship","_id":85,"_name":"EFFETTUARE","_x":-85,"_y":-1086},"86":{"__type":"Relationship","_id":86,"_name":"EFFETTUATO","_x":399,"_y":-771},"87":{"__type":"Attribute","_id":87,"_name":"Inizio","_identifier":false,"_externalIdentifier":true,"_cardinality":"1_1","_parentId":84,"_x":79,"_y":-93},"88":{"__type":"Attribute","_id":88,"_name":"Fine","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":84,"_x":-148,"_y":-45},"89":{"__type":"Participation","_id":89,"_entityId":84,"_tableId":null,"_relationshipId":86,"_cardinality":"1_1","_externalIdentifier":false,"_role":""},"90":{"__type":"Participation","_id":90,"_entityId":20,"_tableId":null,"_relationshipId":86,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},"91":{"__type":"Participation","_id":91,"_entityId":84,"_tableId":null,"_relationshipId":85,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},"92":{"__type":"Participation","_id":92,"_entityId":68,"_tableId":null,"_relationshipId":85,"_cardinality":"0_N","_externalIdentifier":false,"_role":""}},"sqlLinearCode":""},"edited":true,"sceneResetToken":1775028308967,"selectedItemId":null,"selectedTool":null,"oldRenamingValue":"CertConformita","renamingValue":"CertConformita","showRenamingInput":false,"showRenamingRoleInput":false,"showCardinalityMenu":false,"showGeneralizationTypeMenu":false,"showExportMenu":false,"showNotes":false},"erRestructuring":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":""},"edited":true,"sceneResetToken":1775028308967,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showRenamingRoleInput":false,"showMultivalueAttributeMenu":false,"showCompositeAttributeMenu":false,"showGeneralizationMenu":false,"showExportMenu":false},"erTranslation":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":""},"edited":true,"sceneResetToken":1775028308967,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showOneToManyTypeBRelationshipMenu":false,"showOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false,"showExportMenu":false},"schemaDesign":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":"<h3>Relational logical schema</h3><br><h3>Referential integrity constraints</h3>"},"edited":true,"sceneResetToken":1775028308967,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":"<p>Si vuole progettare una base di dati per la gestione delle attività e dei servizi offerti da un centro sportivo multidisciplinare.&nbsp;</p><ul><li>Il centro sportivo dispone di diversi impianti. Ciascun impianto è identificato da un codice univoco ed è caratterizzato da un nome, dalla capienza massima e dall’indirizzo, composto da via, numero civico e CAP.&nbsp;</li><li>La manutenzione degli impianti e l’erogazione delle attività sportive sono affidate ai membri del personale del centro. Ogni membro del personale è caratterizzato da nome, cognome e data di assunzione. Il personale comprende, tra le diverse figure, istruttori e manutentori. Per ogni istruttore si intende memorizzare l’elenco delle specializzazioni possedute (ad esempio nuoto, yoga, crossfit) e l’elenco dei videocorsi di allenamento registrati. Ciascun videocorso è identificato da un codice univoco ed è descritto da nome e durata, espressa in ore. Si assume inoltre che un videocorso possa essere registrato da più istruttori.</li><li>Gli istruttori lavorano a rotazione presso i diversi impianti. Si vuole tener traccia degli intervalli di tempo in cui un insegnante ha lavorato presso ciascun impianto, insieme alla mansione ricoperta. Lo stesso insegnante può lavorare presso lo stesso impianto in intervalli di tempo diversi.</li><li>Per i manutentori è noto l’elenco degli interventi di manutenzione che sono stati effettuati sui diversi impianti nel tempo. Ciascun intervento di manutenzione è caratterizzato dall’indicazione di quando è stato effettuato (data e ora), il manutentore che lo ha eseguito, l’impianto su cui è stato effettuato, l’elenco degli eventuali prodotti che sono stati utilizzati e (per ciascuno) in quale quantità. Si tenga presente che un manutentore non può eseguire contemporaneamente due interventi su due diversi impianti.</li><li>I prodotti che possono essere utilizzati negli interventi di manutenzione sono caratterizzati da un codice univoco, il nome del prodotto, il costo per unità e il marchio. I prodotti possono essere ricambi oppure consumabili. Per i ricambi è noto il modello di apparecchiatura a cui sono destinati e l’elenco delle certificazioni di conformità. Per i consumabili è nota la scadenza se disponibile.</li><li>I soci del centro sportivo sono identificati dal codice fiscale e caratterizzati da nome, cognome e numero di telefono.&nbsp;</li><li>Per accedere ad un impianto, il socio deve sottoscrivere un abbonamento valido per l’accesso a quell’impianto. Ogni abbonamento è identificato da un numero progressivo per l'impianto; di ogni abbonamento sono noti la data di inizio, la data di fine validità e il costo.</li><li>Si vuole inoltre tenere traccia delle sessioni di visualizzazione dei soci relative ai videocorsi disponibili. Per ogni sessione si desidera memorizzare il videocorso visualizzato, l’istante di inizio e l’istante di fine della visualizzazione. Si consideri che un socio non può visualizzare più di un videocorso nello stesso istante, ma può visualizzare più videocorsi diversi oppure lo stesso videocorso più volte nel corso della stessa giornata.</li></ul><p><br></p>","showNotesDataMenu":false}