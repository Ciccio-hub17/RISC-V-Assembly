i (multi)\n}\nentity MANUTENTORE\nentity VIDEOCORSO {\n    ID_VC (id),\n    Nome,\n    Durata\n}\nentity MANSIONE {\n    Data_inizio (external),\n    Nome,\n    Ora_Inizio (external),\n    Data_Fine (optional),\n    Ora_Fine (optional)\n}\nentity INTERVENTO {\n    Ora (external),\n    Data (external)\n}\nentity PRODOTTO {\n    Nome,\n    ID_P (id),\n    CostoUnitario,\n    Marchio\n}\nentity RICAMBIO {\n    modello,\n    CertConformita (multi)\n}\nentity CONSUMABILE {\n    Scadenza (optional)\n}\nentity SOCIO {\n    Nome,\n    Cognome,\n    Cod_fisc (id),\n    Telefono\n}\nentity ABBONAMENTO {\n    ID_AB (external),\n    Data_fine (optional),\n    Costo,\n    Data_inizio\n}\nentity SESSIONE {\n    Inizio (external),\n    Fine (optional)\n}\n\n/* Relationships */\nrelationship REGISTRATO (\n    ISTRUTTORE: zero..many,\n    VIDEOCORSO: one..many\n)\nrelationship SVOLGE (\n    MANSIONE: one..one external,\n    ISTRUTTORE: zero..many\n)\nrelationship IN (\n    IMPIANTO: one..many,\n    MANSIONE: one..one\n)\nrelationship EFFETTUA (\n    INTERVENTO: one..one external,\n    MANUTENTORE: zero..many\n)\nrelationship PRESSO (\n    IMPIANTO: zero..many,\n    INTERVENTO: one..one\n)\nrelationship USARE (\n    PRODOTTO: zero..many,\n    INTERVENTO: zero..many\n) {\n    Qta\n}\nrelationship VALIDO (\n    ABBONAMENTO: one..one external,\n    IMPIANTO: zero..many\n)\nrelationship SOTTOSCRIVERE (\n    ABBONAMENTO: one..one,\n    SOCIO: zero..many\n)\nrelationship EFFETTUARE (\n    SESSIONE: one..one external,\n    SOCIO: zero..many\n)\nrelationship EFFETTUATO (\n    SESSIONE: one..one,\n    VIDEOCORSO: zero..many\n)\n\n/* Generalizations */\nMEMBRO <= {\n    ISTRUTTORE,\n    MANUTENTORE\n} (partial, exclusive)\nPRODOTTO <= {\n    RICAMBIO,\n    CONSUMABILE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Table","_id":115,"_name":"IMPIANTO","_x":1009,"_y":-1596,"_mag":false},{"__type":"Column","_id":119,"_name":"Id_I","_type":"integer","_identifier":true,"_unique":false,