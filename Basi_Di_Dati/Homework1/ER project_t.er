{"_main":{"step":"erTranslation","restructuringHappened":true,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":93,"erCode":"/* Entities */\nentity IMPIANTO {\n    Id_I (id),\n    Nome,\n    Capienza_Massima,\n    Indirizzo {\n        Civico,\n        CAP,\n        Via\n    }\n}\nentity MEMBRO {\n    Cognome,\n    Data_Assunzione,\n    Nome,\n    ID_M (id)\n}\nentity ISTRUTTORE {\n    Specializzazioni (multi)\n}\nentity MANUTENTORE\nentity VIDEOCORSO {\n    ID_VC (id),\n    Nome,\n    Durata\n}\nentity MANSIONE {\n    Data_inizio (external),\n    Nome,\n    Ora_Inizio (external),\n    Data_Fine (optional),\n    Ora_Fine (optional)\n}\nentity INTERVENTO {\n    Ora (external),\n    Data (external)\n}\nentity PRODOTTO {\n    Nome,\n    ID_P (id),\n    CostoUnitario,\n    Marchio\n}\nentity RICAMBIO {\n    modello,\n    CertConformita (multi)\n}\nentity CONSUMABILE {\n    Scadenza (optional)\n}\nentity SOCIO {\n    Nome,\n    Cognome,\n    Cod_fisc (id),\n    Telefono\n}\nentity ABBONAMENTO {\n    ID_AB (external),\n    Data_fine (optional),\n    Costo,\n    Data_inizio\n}\nentity SESSIONE {\n    Inizio (external),\n    Fine (optional)\n}\n\n/* Relationships */\nrelationship REGISTRATO (\n    ISTRUTTORE: zero..many,\n    VIDEOCORSO: one..many\n)\nrelationship SVOLGE (\n    MANSIONE: one..one external,\n    ISTRUTTORE: zero..many\n)\nrelationship IN (\n    IMPIANTO: one..many,\n    MANSIONE: one..one\n)\nrelationship EFFETTUA (\n    INTERVENTO: one..one external,\n    MANUTENTORE: zero..many\n)\nrelationship PRESSO (\n    IMPIANTO: zero..many,\n    INTERVENTO: one..one\n)\nrelationship USARE (\n    PRODOTTO: zero..many,\n    INTERVENTO: zero..many\n) {\n    Qta\n}\nrelationship VALIDO (\n    ABBONAMENTO: one..one external,\n    IMPIANTO: zero..many\n)\nrelationship SOTTOSCRIVERE (\n    ABBONAMENTO: one..one,\n    SOCIO: zero..many\n)\nrelationship EFFETTUARE (\n    SESSIONE: one..one extern