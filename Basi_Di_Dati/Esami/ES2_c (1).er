{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":false},"erDesign":{"model":{"uid":58,"erCode":"/* Entities */\nentity PILOTA {\n    numpatente (id),\n    cognome,\n    nome,\n    data_nascita,\n    annoP\n}\nentity SCUDERIA {\n    nome (id),\n    anno_fondazione (optional),\n    resp_tecnico\n}\nentity UFFICIALI {\n    NOME,\n    POTENZA_MOTORE\n}\nentity CLIENTI\nentity TESSERAMENTO {\n    ANNO (external),\n    STIPENDIO\n}\nentity MECCANICP {\n    MATR (external),\n    CERTIFICAZIONI (multi)\n}\nentity GARA {\n    COD (id),\n    LUNGHEZZA,\n    DATA\n}\nentity RUOLO {\n    CODR (external),\n    NOME,\n    DESCRIZIONE,\n    COMPENSO\n}\n\n/* Relationships */\nrelationship FORNIRE (\n    UFFICIALI: one..many,\n    CLIENTI: one..one\n)\nrelationship TESSERARE_PRESSO (\n    PILOTA: one..many,\n    TESSERAMENTO: one..one external\n)\nrelationship TESSERATO_PRESSO (\n    TESSERAMENTO: one..one,\n    SCUDERIA: zero..many\n)\nrelationship LAVORARE (\n    SCUDERIA: zero..many,\n    MECCANICP: one..one external\n)\nrelationship RICOPRIRE (\n    MECCANICP: zero..many,\n    RUOLO: one..one external\n)\nrelationship MECCANICI (\n    RUOLO: one..one external,\n    GARA: zero..many\n)\n\n/* Generalizations */\nSCUDERIA <= {\n    UFFICIALI,\n    CLIENTI\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":2,"_name":"PILOTA","_x":8006,"_y":-8681,"_mag":false},{"__type":"Attribute","_id":3,"_name":"numpatente","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":2,"_x":-140,"_y":0},{"__type":"Attribute","_id":4,"_name":"cognome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":2,"_x":-138,"_y":-42},{"__type":"Attribute","_id":5,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":2,"_x":-138,"_y":42},{"__type":"Attribute","_id":