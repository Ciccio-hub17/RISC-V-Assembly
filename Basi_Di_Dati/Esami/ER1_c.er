ationshipId":31,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},"41":{"__type":"Attribute","_id":41,"_name":"ORA_INIZIO","_identifier":false,"_externalIdentifier":true,"_cardinality":"1_1","_parentId":34,"_x":-182,"_y":0},"42":{"__type":"Attribute","_id":42,"_name":"ORA_FINE","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":34,"_x":-180,"_y":-55},"43":{"__type":"Attribute","_id":43,"_name":"DATA","_identifier":false,"_externalIdentifier":true,"_cardinality":"1_1","_parentId":34,"_x":-180,"_y":55}},"sqlLinearCode":""},"edited":true,"sceneResetToken":1779710854808,"selectedItemId":null,"selectedTool":null,"oldRenamingValue":"RELATIONSHIP35","renamingValue":"SI_TIENE","showRenamingInput":false,"showRenamingRoleInput":false,"showCardinalityMenu":false,"showGeneralizationTypeMenu":false,"showExportMenu":false,"showNotes":false},"erRestructuring":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":""},"edited":true,"sceneResetToken":1779710854808,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showRenamingRoleInput":false,"showMultivalueAttributeMenu":false,"showCompositeAttributeMenu":false,"showGeneralizationMenu":false,"showExportMenu":false},"erTranslation":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":""},"edited":true,"sceneResetToken":1779710854808,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showOneToManyTypeBRelationshipMenu":false,"showOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false,"showExportMenu":false},"schemaDesign":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":"<h3>Relational logical schema</h3><br><h3>Referential integrity constraints</h3>"},"edited":true,"sceneResetToken":1779710854808,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":"<p>Si vuole realizzare la base dati per la gestione di una conferenza ibrida. Presso una conferenza ibrida i ricercatori possono presentare i risultati delle loro attività di ricerca in modalità “in presenza” oppure rendendo disponibile un video con una presentazione registrata.</p><p>I ricercatori che effettuano almeno una presentazione (in presenza o registrata) presso la conferenza sono caratterizzati da un codice univoco, cognome, nome ed un elenco di affiliazioni.</p><p>Le sale presso cui è tenuta la conferenza sono identificate da un codice univoco e sono caratterizzate da un nome e dalla capienza.</p><p>Le presentazioni effettuate presso la conferenza sono identificate da un codice univoco e se ne conosce il titolo, la categoria, ed il link alla presentazione PowerPoint (se disponibile). Le presentazioni possono essere registrate oppure eseguite in presenza.&nbsp;</p><p>Per le presentazioni registrate si conosce la URL dove è stato caricato il video, la durata del video, e il ricercatore che ha predisposto il video.&nbsp;</p><p>Nella base di dati si vuole tenere traccia delle presentazioni in presenza effettuate dai ricercatori. Per ogni presentazione in presenza è nota la data in cui è effettuata, l’ora di inizio e di fine, la sala presso cui è tenuta ed il ricercatore che effettua la presentazione. Si consideri che presso una stessa sala possono essere svolte più presentazioni, ma non contemporaneamente. Lo stesso ricercatore può effettuare più presentazioni.</p>","showNotesDataMenu":false}