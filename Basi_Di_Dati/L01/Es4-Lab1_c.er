{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":true},"erDesign":{"model":{"uid":34,"erCode":"/* Entities */\nentity AGENTE {\n    Nome {\n        cognome,\n        nome\n    },\n    COD_FISC (id),\n    telefono,\n    email (optional)\n}\nentity AREA_GEOGRAFICA {\n    Citta_principale (id),\n    comuni (optional, multi),\n    abitanti,\n    superficie\n}\nentity AGENZIA {\n    Cod (id),\n    indirizzo\n}\nentity IN_FRANCHISING {\n    Catena\n}\nentity INDIPENDENTE {\n    P_IVA\n}\nentity TEMPO {\n    Data_Inizio (id)\n}\n\n/* Relationships */\nrelationship COPRIRE (\n    AGENTE: one..many,\n    AREA_GEOGRAFICA: one..one\n)\nrelationship ASSEGNARE (\n    AGENTE: zero..many,\n    AGENZIA: zero..many,\n    TEMPO: zero..many\n) {\n    Data_Fine,\n    Tipo_mandato\n}\n\n/* Generalizations */\nAGENZIA <= {\n    IN_FRANCHISING,\n    INDIPENDENTE\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"AGENTE","_x":848,"_y":-1190,"_mag":false},{"__type":"Attribute","_id":2,"_name":"Nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-140,"_y":0},{"__type":"Attribute","_id":3,"_name":"COD_FISC","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":-42},{"__type":"Attribute","_id":4,"_name":"telefono","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":42},{"__type":"Attribute","_id":5,"_name":"cognome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":2,"_x":-100,"_y":16},{"__type":"Attribute","_id":6,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":2,"_x":-98,"_y":-27},{"__type":"Attribute","_id":7,"_name":"email","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-116,"_y