{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":true},"erDesign":{"model":{"uid":30,"erCode":"/* Entities */\nentity FURGONE {\n    modello,\n    targa (id),\n    volume (optional)\n}\nentity CARICHI_SPECIALI {\n    certificazioni (multi)\n}\nentity MAGAZZINI {\n    indirizzo,\n    codice (id),\n    Nome_azienda\n}\nentity TRASCOLO {\n    data (external),\n    nome_autista,\n    Ora_arrivo,\n    Ora_partenza\n}\n\n/* Relationships */\nrelationship EFFETTUARE (\n    TRASCOLO: one..one external,\n    FURGONE: zero..many\n)\nrelationship PARTENZA (\n    TRASCOLO: one..one,\n    MAGAZZINI: zero..many\n)\nrelationship ARRIVO (\n    TRASCOLO: one..one,\n    MAGAZZINI: zero..many\n)\n\n/* Generalizations */\nFURGONE <= {\n    CARICHI_SPECIALI\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"FURGONE","_x":532,"_y":-177,"_mag":false},{"__type":"Attribute","_id":2,"_name":"modello","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-144,"_y":0},{"__type":"Attribute","_id":3,"_name":"targa","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-142,"_y":-43},{"__type":"Attribute","_id":4,"_name":"volume","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-142,"_y":43},{"__type":"Entity","_id":5,"_name":"CARICHI_SPECIALI","_x":378,"_y":66,"_mag":false},{"__type":"Generalization","_id":6,"_type":"p_e","_entityId":1},{"__type":"GeneralizationChild","_id":7,"_entityId":5,"_generalizationId":6},{"__type":"Attribute","_id":8,"_name":"certificazioni","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_N","_parentId":5,"_x":-63,"_y":87},{"__type":"Entity","_id":9,"_name":"MAGAZZINI","_x":1291,"_y":-590,"_mag":false},{"__type":"Attribute","_id":10,"_name":"indirizzo","_identifier":false,"_external