{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":true},"erDesign":{"model":{"uid":26,"erCode":"/* Entities */\nentity DIPENDENTE {\n    indirizzo,\n    nome,\n    Cod (id),\n    qualifiche (multi)\n}\nentity IMPIEGATI {\n    mansione\n}\nentity EDIFICIO {\n    Indirizzo,\n    cod (id),\n    telefono (multi)\n}\nentity TURNO {\n    Ora_inizio,\n    Data (external),\n    Ora_fine,\n    Straordinario (optional)\n}\n\n/* Relationships */\nrelationship SVOLGERSI (\n    TURNO: one..one,\n    EDIFICIO: zero..many\n)\nrelationship ASSOCIATO (\n    TURNO: one..one external,\n    DIPENDENTE: zero..many\n)\n\n/* Generalizations */\nDIPENDENTE <= {\n    IMPIEGATI\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"DIPENDENTE","_x":1009,"_y":-1437,"_mag":false},{"__type":"Attribute","_id":2,"_name":"indirizzo","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-163,"_y":0},{"__type":"Attribute","_id":3,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-161,"_y":-49},{"__type":"Attribute","_id":4,"_name":"Cod","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-161,"_y":49},{"__type":"Attribute","_id":5,"_name":"qualifiche","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_N","_parentId":1,"_x":-116,"_y":-78},{"__type":"Entity","_id":6,"_name":"IMPIEGATI","_x":806,"_y":-1114,"_mag":false},{"__type":"Generalization","_id":8,"_type":"p_e","_entityId":1},{"__type":"GeneralizationChild","_id":9,"_entityId":6,"_generalizationId":8},{"__type":"Attribute","_id":10,"_name":"mansione","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":-157,"_y":0},{"__type":"Entity","_id":11,"_name":"EDIFICIO","_x":1792,"_y":-1442,"_mag":false},{"__type":"Attribut