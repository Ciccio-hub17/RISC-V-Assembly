"_y":43},"18":{"__type":"Relationship","_id":18,"_name":"CONVENZIONE","_x":1472,"_y":-832},"19":{"__type":"Participation","_id":19,"_entityId":14,"_tableId":null,"_relationshipId":18,"_cardinality":"1_N","_externalIdentifier":false,"_role":""},"20":{"__type":"Participation","_id":20,"_entityId":10,"_tableId":null,"_relationshipId":18,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},"22":{"__type":"Entity","_id":22,"_name":"RIPARAZIONE","_x":1005,"_y":-866,"_mag":false},"23":{"__type":"Attribute","_id":23,"_name":"Costo","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":22,"_x":-85,"_y":-99},"24":{"__type":"Attribute","_id":24,"_name":"Data","_identifier":false,"_externalIdentifier":true,"_cardinality":"1_1","_parentId":22,"_x":170,"_y":5},"25":{"__type":"Attribute","_id":25,"_name":"Ore","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":22,"_x":-2,"_y":-88},"26":{"__type":"Relationship","_id":26,"_name":"SUBIRE","_x":797,"_y":-612},"27":{"__type":"Relationship","_id":27,"_name":"EFFETTUARE","_x":1210,"_y":-612},"28":{"__type":"Participation","_id":28,"_entityId":1,"_tableId":null,"_relationshipId":26,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},"29":{"__type":"Participation","_id":29,"_entityId":22,"_tableId":null,"_relationshipId":26,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},"30":{"__type":"Participation","_id":30,"_entityId":22,"_tableId":null,"_relationshipId":27,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},"31":{"__type":"Participation","_id":31,"_entityId":10,"_tableId":null,"_relationshipId":27,"_cardinality":"0_N","_externalIdentifier":false,"_role":""}},"sqlLinearCode":""},"edited":true,"sceneResetToken":1774430499586,"selectedItemId":null,"selectedTool":null,"oldRenamingValue":"RIPARAZIONE","renamingValue":"RIPARAZIONE","showRenamingInput":false,"showRenamingRoleInput":false,"showCardinalityMenu":false,"showGeneralizationTypeMenu":false,"showExportMenu":false,"showNotes":false},"erRestructuring":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":""},"edited":true,"sceneResetToken":1774430499586,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showRenamingRoleInput":false,"showMultivalueAttributeMenu":false,"showCompositeAttributeMenu":false,"showGeneralizationMenu":false,"showExportMenu":false},"erTranslation":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":""},"edited":true,"sceneResetToken":1774430499586,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showOneToManyTypeBRelationshipMenu":false,"showOneToOneTypeBRelationshipMenu":false,"showOneToOneTypeCRelationshipMenu":false,"showExportMenu":false},"schemaDesign":{"model":{"uid":1,"erCode":"","sqlCode":"","itemsArray":[],"itemsMap":{},"sqlLinearCode":"<h3>Relational logical schema</h3><br><h3>Referential integrity constraints</h3>"},"edited":true,"sceneResetToken":1774430499586,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":"<p>Si vuole progettare la base di dati per la gestione delle riparazioni di furgoni. La base di dati deve memorizzare le informazioni relative a un elenco di furgoni, identificati ciascuno dalla targa e per i quali è noto l’anno di immatricolazione. Tra i vari tipi di furgone, per quelli dotati di motore elettrico è nota la capacità della batteria. La base di dati deve anche contenere l’elenco delle officine, identificate da un codice univoco e per le quali è inoltre noto l’indirizzo. Le officine possono essere convenzionate con alcune aziende. Delle aziende convenzionate sono noti partita IVA, nome ed elenco degli eventuali numeri di telefono. Si noti che ogni azienda può essere convenzionata con più officine, e si vuole tenere traccia solo delle aziende convenzionate con almeno una officina. Si vuole inoltre tenere traccia delle riparazioni effettuate nel tempo su ciascun furgone. Di ogni riparazione sono noti la data, il costo e la durata in ore. Si noti che un furgone può subire più riparazioni nello stesso giorno ma in officine diverse. Un’officina effettua al massimo una riparazione per uno stesso furgone nello stesso giorno</p>","showNotesDataMenu":false}