{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":true},"erDesign":{"model":{"uid":26,"erCode":"/* Entities */\nentity IMMOBILE {\n    Indirizzo,\n    COD (id),\n    Superficie,\n    Stanze (multi)\n}\nentity APPARTAMENTO {\n    Piano\n}\nentity AGENZIA {\n    Indirizzo,\n    Codice (id),\n    Telefono (multi)\n}\nentity CONTRATTO {\n    Rinnovabile,\n    Data_Inizio (external),\n    Prezzo_Mensile,\n    Data_Fine\n}\n\n/* Relationships */\nrelationship STIPULATO (\n    IMMOBILE: zero..many,\n    CONTRATTO: one..one external\n)\nrelationship STIPULARE (\n    AGENZIA: zero..many,\n    CONTRATTO: one..one\n)\n\n/* Generalizations */\nIMMOBILE <= {\n    APPARTAMENTO\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"IMMOBILE","_x":759,"_y":-994,"_mag":false},{"__type":"Attribute","_id":2,"_name":"Indirizzo","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-150,"_y":0},{"__type":"Attribute","_id":3,"_name":"COD","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-148,"_y":-45},{"__type":"Attribute","_id":4,"_name":"Superficie","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-148,"_y":45},{"__type":"Attribute","_id":5,"_name":"Stanze","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_N","_parentId":1,"_x":-116,"_y":-78},{"__type":"Entity","_id":6,"_name":"APPARTAMENTO","_x":590,"_y":-714,"_mag":false},{"__type":"Generalization","_id":7,"_type":"p_e","_entityId":1},{"__type":"GeneralizationChild","_id":8,"_entityId":6,"_generalizationId":7},{"__type":"Attribute","_id":9,"_name":"Piano","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":6,"_x":-176,"_y":0},{"__type":"Entity","_id":10,"_name":"AGENZIA","_x":1589,"_y":-981,"_mag":false},{"__type":"Att