{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":true},"erDesign":{"model":{"uid":34,"erCode":"/* Entities */\nentity OPERAIO {\n    nome,\n    cod (id),\n    cognome,\n    telefono (optional)\n}\nentity PRODOTTO {\n    categorie (multi),\n    barre (id),\n    durata_processo,\n    costo\n}\nentity MACCHINARIO {\n    Marca,\n    IDM (id),\n    Modello\n}\nentity PRODUZIONE {\n    Consumo_max\n}\nentity QUALITA {\n    Parametro_verifica\n}\nentity TEMPO {\n    data_inizio (id),\n    ora_inizio (id)\n}\n\n/* Relationships */\nrelationship ASSOCIATO (\n    OPERAIO: one..many,\n    PRODOTTO: zero..many\n)\nrelationship ISPEZIONE (\n    OPERAIO: zero..many,\n    MACCHINARIO: zero..many,\n    TEMPO: zero..many\n) {\n    ora_fine,\n    data_fine\n}\n\n/* Generalizations */\nMACCHINARIO <= {\n    PRODUZIONE,\n    QUALITA\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"OPERAIO","_x":1086,"_y":-1668,"_mag":false},{"__type":"Attribute","_id":2,"_name":"nome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-144,"_y":0},{"__type":"Attribute","_id":3,"_name":"cod","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-142,"_y":-43},{"__type":"Attribute","_id":4,"_name":"cognome","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-142,"_y":43},{"__type":"Attribute","_id":5,"_name":"telefono","_identifier":false,"_externalIdentifier":false,"_cardinality":"0_1","_parentId":1,"_x":-116,"_y":-78},{"__type":"Entity","_id":6,"_name":"PRODOTTO","_x":1915,"_y":-1672,"_mag":false},{"__type":"Attribute","_id":7,"_name":"categorie","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_N","_parentId":6,"_x":164,"_y":-21},{"__type":"Attribute","_id":8,"_name":"barre","_identifier":true,"_externalIdentifier